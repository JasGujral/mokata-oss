.DS_Store
*.log
.env

# Claude Code local settings (machine-specific; should not be committed)
.claude/

# Python build/cache artifacts
__pycache__/
*.pyc
*.egg-info/
# Wheel/sdist build output (regenerable via `python -m build`; never track it).
# ANCHORED to the repo root (leading slash) so these do NOT also match docs/build/ —
# the internal build-docs dir (STATUS, plans) that MUST stay tracked. An unanchored
# `build/` matches a `build` dir at ANY depth, which silently ignored new docs/build files.
/build/
/dist/

# Local helper script (one-off; not part of the framework)
push-to-github.command

# MkDocs build output
site/
uv.lock

# The Complete Guide PDF is generated from its markdown in CI (single source, no drift);
# never commit a static render (it would drift from the page).
docs/tutorials/mokata-complete-guide.pdf

# Runtime artifact: mokata creates .mokata/ at a repo root when run there (tests/commands).
# The framework source repo is not itself a mokata project, so never track it.
.mokata/
# Exported brainstorm plan copies — test/run artifacts, never source. Backstops the
# test-isolation guard so a stray plans/<slug>.md can never sneak into the tree.
/plans/
tests/plans/
# Release script backups (scripts/release-*.sh) — local safety copies, not source.
release-backup-*/

# Build-session scratch. `_to_delete/` accumulated 1.2GB of snapshot tarballs, git lock
# fixtures and pre-edit source backups across the 0.0.16 stages. NOTE THE LIMIT OF THIS
# ENTRY: gitignoring a path does NOT stop it reaching the public mirror — sync-public.sh
# mirrors the WORKING TREE with rsync, which ignores .gitignore entirely. The real control
# is the --exclude list + INTERNAL_PATHS guard in scripts/sync-public.sh, and `_to_delete/`
# is registered in BOTH. This entry only keeps it out of `git add -A`.
_to_delete/
# Scratch snapshots and git-lock fixtures left by build/verification sessions.
*.tgz
_stale_HEAD.lock*
_stale_index.lock*
# scripts/mutate.sh's exclusive-run lock. Lives only for the length of a mutation run; a file
# left here after one means a run was SIGKILLed, and the next run reclaims it (dead pid = corpse).
.mutate.lock
# Local Postgres data dirs from live-DB test legs (DB.S2b/DB.S5 integration).
pgdata/
*-pgdata/

# Marketing / brand assets — kept local, not shipped with the OSS code or a hotfix.
# (Publish deliberately as a separate step if/when desired.)
docs/marketing/
mokata-ad-features.md

# Large launch/marketing media — hosted elsewhere (or Git LFS), never in git history.
mokata_ad_60s_memory_vertical.mp4
docs/launch/assets/

# VS Code extension build artifacts (editors/vscode — future 0.8.0/0.9.0 work)
editors/vscode/node_modules/
editors/vscode/out/
.mokata_probe_test/

# Client technical-review deck — GENERATED render output only; the source beside it
# (slides.py, theme.css, the two gen_*.py, README, SCRIPT.md, 00-design.md) IS tracked.
# `build/` holds deck.html + the PDF + slide PNGs; `diagrams/*.svg` are emitted by
# gen_arch.py / gen_more.py. Both are regenerable, and left untracked they would trip
# release.sh's `git status --porcelain` cleanliness gate at the next cut.
# FULLY ANCHORED on purpose — see the /build/ note above: a bare `build/` would also
# match docs/build/, the internal build-docs dir that MUST stay tracked.
docs/talks/client-technical-review/deck/build/
docs/talks/client-technical-review/deck/diagrams/*.svg
