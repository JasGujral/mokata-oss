# mokata — team environment template.
#
# Copy to `.env` (never commit `.env` — it is gitignored) and fill in real values:
#   cp .env.example .env
#
# This file ships PLACEHOLDERS ONLY. Put no real credential here — the real secret lives in your
# local `.env` / your shell, and mokata never stores it (it reads $MOKATA_PG_DSN at run time).

# ---------------------------------------------------------------------------------------------
# docker-compose.team.yml creds (the self-host path). `docker compose` reads these from `.env`.
# If you use a managed Postgres (Supabase / Neon / RDS) instead, you can ignore this block and
# set only MOKATA_PG_DSN below.
# ---------------------------------------------------------------------------------------------
POSTGRES_USER=mokata
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_DB=mokata
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------------------------
# The one env var mokata needs for team mode: the DSN of YOUR Postgres. mokata hosts nothing.
#
# Use a DIRECT / SESSION connection string — NOT a transaction-mode pooler (e.g. a pgBouncer /
# Supabase "Transaction" pooler endpoint). mokata uses Postgres LISTEN/NOTIFY for push cache
# invalidation, and LISTEN/NOTIFY does not survive a transaction-mode pooler. Prefer the direct
# 5432 endpoint (or a "Session"-mode pooler) so notifications work.
#
# Fill in the user / password / host / port / database (matching the POSTGRES_* values above
# when using docker compose — e.g. user "mokata", host "localhost", port 5432, db "mokata"):
MOKATA_PG_DSN=postgres://<user>:<password>@<host>:<port>/<database>

# ---------------------------------------------------------------------------------------------
# Optional: a SEPARATE database for the tamper-resistant audit ledger (defaults to MOKATA_PG_DSN
# when unset). Same direct/session-connection rule applies. Uncomment to split it out.
# ---------------------------------------------------------------------------------------------
# MOKATA_AUDIT_PG_DSN=postgres://<user>:<password>@<host>:<port>/<database>

# ---------------------------------------------------------------------------------------------
# Optional: host port for the opt-in observability metrics exporter
# (docker compose --profile observability). Off the golden path.
# ---------------------------------------------------------------------------------------------
# METRICS_PORT=9187
