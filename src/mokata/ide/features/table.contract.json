{
 "schemas": {
  "TableSummary": {
   "type": "object",
   "properties": {
    "rows": {
     "type": [
      "integer",
      "null"
     ]
    },
    "complete": {
     "type": "boolean"
    },
    "ragged": {
     "type": "integer"
    },
    "bad_utf8": {
     "type": "integer"
    },
    "cut": {
     "type": "integer"
    }
   }
  },
  "TableInfo": {
