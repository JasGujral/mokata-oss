    },
    "header": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "width": {
     "type": "integer"
    },
    "page": {
     "type": "integer"
    },
    "page_max": {
     "type": "integer"
    },
    "cell_max": {
     "type": "integer"
    },
    "rows": {
     "type": [
      "integer",
      "null"
     ]
    },
    "complete": {
     "type": "boolean"
    },
    "ragged": {
     "type": "integer"
    },
    "bad_utf8": {
     "type": "integer"
    },
    "cut": {
     "type": "integer"
    },
    "estimate": {
     "type": "integer"
    },
    "sample": {
     "type": "boolean"
    },
    "cache": {
     "type": "object"
    },
    "encoding": {
     "enum": [
      "utf-8",
      "utf-16-le",
      "utf-16-be"
     ]
    },
    "record_max": {
