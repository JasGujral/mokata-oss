{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" session-start --plugin-root \"${CLAUDE_PLUGIN_ROOT}\" --via-plugin"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" user-prompt-submit --via-plugin"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" secret-guard --via-plugin"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Skill|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" gate-guard --via-plugin"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" dirty-track --via-plugin"
          }
        ]
      },
      {
        "matcher": "^mcp__(?:plugin_mokata_)?mokata__session_save$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" run-bind --via-plugin"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" pre-compact --via-plugin"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" subagent-start --via-plugin"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" subagent-stop --via-plugin"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" stop --via-plugin"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mokata/hooks/mokata-hook-launch\" session-end --via-plugin"
          }
        ]
      }
    ]
  }
}
